{
  "schemaVersion": 1,
  "id": "stock.news.10jqka",
  "version": 5,
  "name": "同花顺财经新闻",
  "summary": "用户想看最新财经新闻 / 股市快讯时用本配方：填好 inputs 让 run_workflow 一次取回同花顺推送 JSON 并渲染成标题列表，模型不读新闻正文；改条件（翻页 / 分类 / 展示字段）按 inputs 重跑，取不到如实说明、不编造。inputs 缺省值（page=1 首页、pagesize=20 默认一次展示量、tag 空、format=list、fields 默认只显示标题、note 沿用旧配方免责原文）均有旧配方明文出处，不是拟合常数。",
  "routeHint": [
    "用户想看最新财经新闻 / 股市快讯时",
    "查股价 / 聊股票话题不走这条"
  ],
  "primitives": [],
  "prompt": "用户想看最新财经新闻 / 股市快讯时才用本配方；只是聊股票话题、或要查某只股票的价格（那是「查股价」技能的职责）就正常回答。填好 inputs 让 run_workflow 跑一遍，列表由宿主 display 算子落地，你不要复述、归纳、翻译或补充任何一条新闻，也不要在回复里写网址或链接。\n\n收尾只写一句简短引导语（如「已为你列出最新的财经新闻，见上方列表。」）；任一节点取不到、返回异常或不是合法 JSON 时如实说明本次没能列出新闻并停笔，不反复重试、不编造新闻。",
  "category": "财经",
  "inputs": [
    {
      "name": "page",
      "type": "integer",
      "default": 1
    },
    {
      "name": "pagesize",
      "type": "integer",
      "default": 20
    },
    {
      "name": "tag",
      "type": "string",
      "default": ""
    },
    {
      "name": "fields",
      "type": "array",
      "default": [
        {
          "key": "title",
          "hrefKey": "url"
        }
      ]
    },
    {
      "name": "format",
      "type": "string",
      "default": "list",
      "enum": [
        "list",
        "table"
      ]
    },
    {
      "name": "note",
      "type": "string",
      "default": "新闻可能有滞后，仅供参考，不构成投资建议。"
    }
  ],
  "workflow": {
    "steps": [
      {
        "id": "fetch",
        "call": "web_fetch",
        "args": {
          "url": "https://news.10jqka.com.cn/tapp/news/push/stock/?page={{input.page}}&tag={{input.tag}}&track=website&pagesize={{input.pagesize}}",
          "storeOnly": true
        }
      },
      {
        "id": "extract",
        "call": "json.get",
        "args": {
          "path": "data.list"
        },
        "bindings": [
          {
            "from": "fetch",
            "path": "$",
            "as": "value"
          }
        ]
      },
      {
        "id": "display",
        "call": "display",
        "args": {
          "format": "{{input.format}}",
          "fields": "{{input.fields}}",
          "note": "{{input.note}}"
        },
        "bindings": [
          {
            "from": "extract",
            "path": "$",
            "as": "value"
          }
        ]
      }
    ]
  }
}

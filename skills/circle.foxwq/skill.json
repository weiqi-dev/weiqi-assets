{
  "schemaVersion": 1,
  "id": "circle.foxwq",
  "version": 2,
  "name": "弈友圈",
  "summary": "分析某个野狐账号的弈友圈：按昵称查 UID，使用通用 web_fetch 与 JSON 沙箱算子分页获取主账号棋谱、提取交战对手并逐个抓取，再由 circle.normalize 生成关系事实供模型分析。",
  "routeHint": [
    "分析某野狐账号的弈友圈",
    "看看这个野狐号最近都跟谁下棋",
    "找出野狐上经常互相交战的账号群体"
  ],
  "category": "围棋",
  "primitives": [],
  "prompt": "用户想分析某个野狐账号的弈友圈时使用本配方；只查单个棋手资料、定式或棋谱时不要使用。先确认用户给出野狐昵称。Workflow 使用通用 web_fetch 请求公开接口，repeat 负责分页，forEach 负责逐个采集对手，JSON 沙箱算子负责解析、筛选、去重与整理，circle.normalize 只计算关系事实。\\n\\n分析时依据 stats、nodes、components、commonOpponents 中的实际计数归纳关系，不要把局数当作熟人阈值。stats.fetchFailures 大于 0 时必须说明有部分对手采集失败，结论只基于成功取得的数据；不要声称数据完整。pages 和 opponentCount 是本次采集规模限制，不代表账号全部历史棋谱。\\n\\n任一必要节点失败或数据结构不合法时，如实说明本次无法完成，不编造账号、棋谱或关系结论。",
  "inputs": [
    {
      "name": "nickname",
      "type": "string",
      "required": true
    },
    {
      "name": "pages",
      "type": "integer",
      "default": 1
    },
    {
      "name": "opponentCount",
      "type": "integer",
      "default": 8
    }
  ],
  "workflow": {
    "steps": [
      {
        "id": "fetchUser",
        "call": "web_fetch",
        "args": {
          "url": "https://newframe.foxwq.com/cgi/QueryUserInfoPanel?srcuid=0&username={{urlencode.input.nickname}}",
          "storeOnly": true
        }
      },
      {
        "id": "checkUser",
        "call": "json.assert",
        "args": {
          "equals": 0,
          "message": "野狐昵称未查到或账号接口返回失败"
        },
        "bindings": [
          {
            "from": "fetchUser",
            "path": "result",
            "as": "value"
          }
        ]
      },
      {
        "id": "uidRaw",
        "call": "json.get",
        "args": {
          "path": "uid"
        },
        "bindings": [
          {
            "from": "fetchUser",
            "path": "$",
            "as": "value"
          }
        ]
      },
      {
        "id": "rootUid",
        "call": "json.toString",
        "args": {},
        "bindings": [
          {
            "from": "uidRaw",
            "path": "$",
            "as": "value"
          }
        ]
      },
      {
        "id": "rootUidList",
        "call": "json.append",
        "args": {
          "items": []
        },
        "bindings": [
          {
            "from": "rootUid",
            "path": "$",
            "as": "value"
          }
        ]
      },
      {
        "id": "rootFetch",
        "forEach": {
          "from": "rootUidList",
          "path": "$",
          "steps": [
            {
              "id": "rootPages",
              "repeat": {
                "maxIterations": "{{input.pages}}",
                "initialState": {
                  "lastcode": "0"
                },
                "stateFrom": {
                  "from": "rootFetchPage",
                  "path": "$"
                },
                "until": {
                  "from": "rootCursorEmpty",
                  "path": "$"
                },
                "steps": [
                  {
                    "id": "rootFetchPage",
                    "call": "web_fetch",
                    "args": {
                      "url": "https://h5.foxwq.com/yehuDiamond/chessbook_local/YHWQFetchChessList?srcuid=0&dstuid={{urlencode.item}}&type=1&lastcode={{urlencode.state.lastcode}}&searchkey=&uin={{urlencode.item}}",
                      "storeOnly": true
                    }
                  },
                  {
                    "id": "rootCursor",
                    "call": "json.get",
                    "args": {
                      "path": "lastcode",
                      "default": ""
                    },
                    "bindings": [
                      {
                        "from": "rootFetchPage",
                        "path": "$",
                        "as": "value"
                      }
                    ]
                  },
                  {
                    "id": "rootCursorEmpty",
                    "call": "json.isEmpty",
                    "args": {},
                    "bindings": [
                      {
                        "from": "rootCursor",
                        "path": "$",
                        "as": "value"
                      }
                    ]
                  },
                  {
                    "id": "rootPageGames",
                    "call": "json.get",
                    "args": {
                      "path": "chesslist"
                    },
                    "bindings": [
                      {
                        "from": "rootFetchPage",
                        "path": "$",
                        "as": "value"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id": "rootPageArrays",
        "call": "json.get",
        "args": {
          "path": "0.items"
        },
        "bindings": [
          {
            "from": "rootFetch",
            "path": "$",
            "as": "value"
          }
        ]
      },
      {
        "id": "rootGames",
        "call": "json.flatten",
        "args": {},
        "bindings": [
          {
            "from": "rootPageArrays",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "whereWhiteRoot",
        "call": "json.set",
        "args": {
          "value": {},
          "path": "whiteuid"
        },
        "bindings": [
          {
            "from": "rootUid",
            "path": "$",
            "as": "nextValue"
          }
        ]
      },
      {
        "id": "whiteRootRows",
        "call": "json.select",
        "args": {},
        "bindings": [
          {
            "from": "rootGames",
            "path": "$",
            "as": "items"
          },
          {
            "from": "whereWhiteRoot",
            "path": "$",
            "as": "where"
          }
        ]
      },
      {
        "id": "blackOpponents",
        "call": "json.pluck",
        "args": {
          "path": "blackuid"
        },
        "bindings": [
          {
            "from": "whiteRootRows",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "whereBlackRoot",
        "call": "json.set",
        "args": {
          "value": {},
          "path": "blackuid"
        },
        "bindings": [
          {
            "from": "rootUid",
            "path": "$",
            "as": "nextValue"
          }
        ]
      },
      {
        "id": "blackRootRows",
        "call": "json.select",
        "args": {},
        "bindings": [
          {
            "from": "rootGames",
            "path": "$",
            "as": "items"
          },
          {
            "from": "whereBlackRoot",
            "path": "$",
            "as": "where"
          }
        ]
      },
      {
        "id": "whiteOpponents",
        "call": "json.pluck",
        "args": {
          "path": "whiteuid"
        },
        "bindings": [
          {
            "from": "blackRootRows",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "opponentCandidates",
        "call": "json.concat",
        "args": {},
        "bindings": [
          {
            "from": "blackOpponents",
            "path": "$",
            "as": "left"
          },
          {
            "from": "whiteOpponents",
            "path": "$",
            "as": "right"
          }
        ]
      },
      {
        "id": "opponentCounts",
        "call": "json.groupCount",
        "args": {
          "path": "$"
        },
        "bindings": [
          {
            "from": "opponentCandidates",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "topOpponents",
        "call": "json.take",
        "args": {
          "count": "{{input.opponentCount}}"
        },
        "bindings": [
          {
            "from": "opponentCounts",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "opponentUids",
        "call": "json.pluck",
        "args": {
          "path": "key"
        },
        "bindings": [
          {
            "from": "topOpponents",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "opponentFetch",
        "forEach": {
          "from": "opponentUids",
          "path": "$",
          "onError": "continue",
          "steps": [
            {
              "id": "opponentPages",
              "repeat": {
                "maxIterations": "{{input.pages}}",
                "initialState": {
                  "lastcode": "0"
                },
                "stateFrom": {
                  "from": "opponentFetchPage",
                  "path": "$"
                },
                "until": {
                  "from": "opponentCursorEmpty",
                  "path": "$"
                },
                "steps": [
                  {
                    "id": "opponentFetchPage",
                    "call": "web_fetch",
                    "args": {
                      "url": "https://h5.foxwq.com/yehuDiamond/chessbook_local/YHWQFetchChessList?srcuid=0&dstuid={{urlencode.item}}&type=1&lastcode={{urlencode.state.lastcode}}&searchkey=&uin={{urlencode.item}}",
                      "storeOnly": true
                    }
                  },
                  {
                    "id": "opponentCursor",
                    "call": "json.get",
                    "args": {
                      "path": "lastcode",
                      "default": ""
                    },
                    "bindings": [
                      {
                        "from": "opponentFetchPage",
                        "path": "$",
                        "as": "value"
                      }
                    ]
                  },
                  {
                    "id": "opponentCursorEmpty",
                    "call": "json.isEmpty",
                    "args": {},
                    "bindings": [
                      {
                        "from": "opponentCursor",
                        "path": "$",
                        "as": "value"
                      }
                    ]
                  },
                  {
                    "id": "opponentPageGames",
                    "call": "json.get",
                    "args": {
                      "path": "chesslist"
                    },
                    "bindings": [
                      {
                        "from": "opponentFetchPage",
                        "path": "$",
                        "as": "value"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id": "opponentPageArrays",
        "call": "json.pluck",
        "args": {
          "path": "value.items",
          "where": {
            "ok": true
          }
        },
        "bindings": [
          {
            "from": "opponentFetch",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "opponentGames",
        "call": "json.flatten",
        "args": {},
        "bindings": [
          {
            "from": "opponentPageArrays",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "allGames",
        "call": "json.concat",
        "args": {},
        "bindings": [
          {
            "from": "rootGames",
            "path": "$",
            "as": "left"
          },
          {
            "from": "opponentGames",
            "path": "$",
            "as": "right"
          }
        ]
      },
      {
        "id": "uniqueGames",
        "call": "json.unique",
        "args": {
          "key": "chessid"
        },
        "bindings": [
          {
            "from": "allGames",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "failedOpponents",
        "call": "json.select",
        "args": {
          "where": {
            "ok": false
          }
        },
        "bindings": [
          {
            "from": "opponentFetch",
            "path": "$",
            "as": "items"
          }
        ]
      },
      {
        "id": "failureCount",
        "call": "json.get",
        "args": {
          "path": "length"
        },
        "bindings": [
          {
            "from": "failedOpponents",
            "path": "$",
            "as": "value"
          }
        ]
      },
      {
        "id": "normalize",
        "call": "circle.normalize",
        "bindings": [
          {
            "from": "uniqueGames",
            "path": "$",
            "as": "games"
          },
          {
            "from": "rootUid",
            "path": "$",
            "as": "rootUid"
          },
          {
            "from": "failureCount",
            "path": "$",
            "as": "fetchFailures"
          }
        ],
        "yield": true
      }
    ]
  },
  "llmProjection": {
    "keep": [
      "stats",
      "nodes",
      "components",
      "commonOpponents"
    ]
  },
  "returnToLLM": true
}

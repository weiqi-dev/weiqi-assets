{
  "schemaVersion": 1,
  "id": "baidu.hotsearch",
  "version": 6,
  "name": "百度热搜",
  "summary": "取回百度实时热搜榜页面，用沙箱正则算子提取热搜关键词，并由宿主通用 display 展示",
  "category": "搜索",
  "routeHint": [
    "用户说「查百度热搜」时",
    "用户说「看看今天的热搜」时",
    "用户说「百度热搜榜」时"
  ],
  "primitives": [],
  "workflow": {
    "steps": [
      {
        "id": "fetch",
        "call": "web_fetch",
        "args": {
          "url": "https://top.baidu.com/board?tab=realtime",
          "storeOnly": true
        }
      },
      {
        "id": "extract",
        "call": "regex.extract",
        "args": {
          "pattern": "\"word\":\"([^\"]+)\"",
          "group": 1,
          "unique": true,
          "withIndex": true
        },
        "bindings": [
          {
            "from": "fetch",
            "path": "$",
            "as": "text"
          }
        ]
      },
      {
        "id": "show",
        "call": "display",
        "args": {
          "format": "list",
          "fields": [
            {
              "key": "value",
              "label": "热搜关键词"
            }
          ],
          "note": "数据来源：百度热搜榜（实时）"
        },
        "bindings": [
          {
            "from": "extract",
            "path": "$",
            "as": "value"
          }
        ],
        "yield": true
      }
    ]
  },
  "inputs": [],
  "prompt": "本技能通过固定工作流完成：取回百度实时热搜榜页面 → 用沙箱插件 regex.extract 正则算子抽出每条热搜的 word 关键词 → 由宿主直接渲染成列表。列表由宿主展示，不要复述或归纳条目内容，也不要把网页正文读回上下文。"
}

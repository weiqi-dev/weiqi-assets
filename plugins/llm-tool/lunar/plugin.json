{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "llm-tool.lunar",
  "name": "公历转农历",
  "type": "plugin",
  "pointId": "llm-tool",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/llm-tool/lunar/index.js",
  "origin": "manual",
  "intent": "让对话里的模型能把公历日期或日期范围换算成农历，并查 24 节气与传统节日；不联网、不依赖运行时时钟。节气用 HKO 1901-2100 逐年事实表，传统节日按明说的民俗约定判定。",
  "readme": "plugins/llm-tool/lunar/README.md",
  "license": "MIT",
  "tags": [
    "llm-tool",
    "calendar",
    "lunar",
    "date-range",
    "solar-term",
    "festival"
  ],
  "exposes": [
    {
      "name": "toLunar",
      "description": "公历转农历。传 {date:YYYY-MM-DD} 或 {from,to} 或 {year,month,day}。返回 {from,to,count,days[]}；days 每项含 solar、lunar{年月日,isLeap}、lunarText、solarTerm（当日节气名或 null）、festival（当日传统节日名或 null）。",
      "params": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "单日 YYYY-MM-DD"
          },
          "from": {
            "type": "string",
            "description": "范围起始 YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "范围结束 YYYY-MM-DD"
          },
          "year": {
            "type": "number",
            "description": "数字形式单日的公历年"
          },
          "month": {
            "type": "number",
            "description": "数字形式单日的公历月"
          },
          "day": {
            "type": "number",
            "description": "数字形式单日的公历日"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "solarTerms",
      "description": "查 24 节气。传 {year:2027} 或 {from:2025,to:2027}（数字年份，含首尾）。返回 {years:[{year,terms:[{name,solar}]}],count}，每年恰好 24 个节气，日期来自 HKO 逐年事实表；1901-2100 之外的年份明确报错。",
      "params": {
        "type": "object",
        "properties": {
          "year": {
            "type": "number",
            "description": "单个公历年（1901-2100）"
          },
          "from": {
            "type": "number",
            "description": "连续年份范围起始"
          },
          "to": {
            "type": "number",
            "description": "连续年份范围结束"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "festivals",
      "description": "查传统节日。传 {date:YYYY-MM-DD} 或 {from,to}。返回 {from,to,count,days[]}，只含命中节日的日期；days 每项 {solar,lunar,festival}。规则：春节正月初一、元宵正月十五、端午五月初五、七夕七月初七、中元七月十五、中秋八月十五、重阳九月初九、腊八腊月初八、除夕=该腊月最后一天（廿九或三十）；闰月不算节日。",
      "params": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "单日 YYYY-MM-DD"
          },
          "from": {
            "type": "string",
            "description": "范围起始 YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "范围结束 YYYY-MM-DD"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "smoke": [
    {
      "method": "toLunar",
      "args": [
        {
          "date": "2026-11-17"
        }
      ],
      "expect": {
        "from": "2026-11-17",
        "to": "2026-11-17",
        "count": 1,
        "days": [
          {
            "solar": "2026-11-17",
            "lunar": {
              "year": 2026,
              "month": 10,
              "day": 9,
              "isLeap": false
            },
            "lunarText": "十月初九",
            "solarTerm": null,
            "festival": null
          }
        ]
      }
    },

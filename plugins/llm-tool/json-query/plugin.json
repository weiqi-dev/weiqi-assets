{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "llm-tool.json-query",
  "name": "JSON 查询与提取",
  "type": "plugin",
  "pointId": "llm-tool",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/llm-tool/json-query/index.js",
  "origin": "manual",
  "intent": "给对话里的模型一个确定性的 JSON 提取能力：按路径选取节点、按条件筛选、全文正则搜索、只看结构轮廓，避免模型通读大 JSON 时漏读或补写看不到的数据。类似命令行里 grep / 路径选择那一层，但输入输出都是 JSON。",
  "readme": "plugins/llm-tool/json-query/README.md",
  "license": "MIT",
  "tags": ["llm-tool", "json", "query", "grep", "select", "filter"],
  "exposes": [
    {
      "name": "query",
      "description": "按路径表达式选取 JSON 节点，可选按 where 条件逐项筛选、按 pick 只保留指定字段、按 limit 限量、按 count 只回计数。json 与 text 二选一：json 传已解析的值，text 传 JSON 字符串（由本库解析，解析失败明确报错，不猜测）。select 省略或 '$' 表示根节点本身；where 作用于每个候选节点。返回 {ok, matched, returned?, truncated?, items[]}；paths 默认 true，items 每项为 {path, value}，paths:false 时 items 每项直接是值；count:true 时只回 {ok, matched}，不回 items。不设默认 limit，不传就全量返回。",
      "params": {
        "type": "object",
        "properties": {
          "json": { "description": "已解析的 JSON 值（对象/数组/标量）；与 text 二选一" },
          "text": { "type": "string", "description": "JSON 文本字符串；与 json 二选一，由本库严格解析" },
          "select": { "type": "string", "description": "路径表达式，如 'Years.2027[*].Name'、'..CompDays[*]'、'list[-1]'；省略为根节点" },
          "where": { "type": "array", "description": "条件数组，项间为 AND；每项 {path?, op, value?, flags?}。op 见 README：exists/eq/ne/in/contains/startsWith/endsWith/gt/gte/lt/lte/match", "items": { "type": "object" } },
          "pick": { "type": "array", "items": { "type": "string" }, "description": "只保留这些顶层字段；对数组会逐元素投影" },
          "limit": { "type": "integer", "minimum": 1, "description": "最多回多少项；不传则不限" },
          "count": { "type": "boolean", "description": "true 时只回 {ok, matched}，不回 items" },
          "paths": { "type": "boolean", "description": "默认 true，items 带 path；false 时 items 直接是值" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "grep",
      "description": "遍历 JSON 的全部标量节点（字符串/数值/布尔/null），用正则匹配其字符串形式，返回带路径的命中项，类似 grep -n 的路径 + grep -c 的计数。对象和数组本身不参与匹配，只匹配叶子值。pattern 是正则字符串，flags 可选且禁止 g / y（会引入 lastIndex 状态使结果不确定）。json 与 text 二选一；支持 count / limit / paths；不支持 where 和 pick（先用 query 选范围再 grep，或用 outline 探结构）。返回形状与 query 相同。",
      "params": {
        "type": "object",
        "properties": {
          "json": { "description": "已解析的 JSON 值；与 text 二选一" },
          "text": { "type": "string", "description": "JSON 文本字符串；与 json 二选一" },
          "pattern": { "type": "string", "description": "正则表达式字符串，如 '^2027-'、'2026|2027'；语法受 QuickJS 正则实现限制" },
          "flags": { "type": "string", "description": "正则标志，如 'i'（忽略大小写）；不含 g / y；省略为空" },
          "limit": { "type": "integer", "minimum": 1, "description": "最多回多少项；不传则不限" },
          "count": { "type": "boolean", "description": "true 时只回 {ok, matched}" },
          "paths": { "type": "boolean", "description": "默认 true，items 带 path；false 时 items 直接是值" }
        },
        "required": ["pattern"],
        "additionalProperties": false
      }
    },
    {
      "name": "outline",
      "description": "描述给定路径命中节点的一层结构，不展开子层：对象回 {type:'object', keys:[...]}，数组回 {type:'array', length:n}，标量回 {type, value}。每项都带 path。用于在不知道 JSON 长什么样时先探结构，再决定 select / grep 怎么写。path 省略为根节点。返回 {ok, matched, nodes[]}，不受 count / limit 影响。",
      "params": {
        "type": "object",
        "properties": {
          "json": { "description": "已解析的 JSON 值；与 text 二选一" },
          "text": { "type": "string", "description": "JSON 文本字符串；与 json 二选一" },
          "path": { "type": "string", "description": "路径表达式；省略为根节点" }
        },
        "additionalProperties": false
      }
    }
  ],
  "smoke": [
    {
      "method": "query",
      "args": [{ "json": { "Years": { "2027": [{ "Name": "春节", "StartDate": "2027-02-05", "CompDays": ["2027-01-31"] }, { "Name": "元旦", "CompDays": [] }] }, "Generated": "20261107T014237Z" }, "select": "Years.2027[*].Name" }],
      "expect": { "ok": true, "matched": 2, "returned": 2, "truncated": false, "items": [{ "path": "$.Years.2027[0].Name", "value": "春节" }, { "path": "$.Years.2027[1].Name", "value": "元旦" }] }
    },
    {
      "method": "query",
      "args": [{ "json": { "Years": { "2027": [{ "Name": "春节", "StartDate": "2027-02-05", "CompDays": ["2027-01-31"] }, { "Name": "元旦", "CompDays": [] }] }, "Generated": "20261107T014237Z" }, "select": "Years.2027[*]", "where": [{ "path": "Name", "op": "contains", "value": "节" }], "pick": ["Name"], "paths": false }],
      "expect": { "ok": true, "matched": 1, "returned": 1, "truncated": false, "items": [{ "Name": "春节" }] }
    },
    {
      "method": "query",
      "args": [{ "json": { "Years": { "2027": [{ "Name": "春节", "StartDate": "2027-02-05", "CompDays": ["2027-01-31"] }, { "Name": "元旦", "CompDays": [] }] }, "Generated": "20261107T014237Z" }, "select": "Years.2027[-1].Name", "count": true }],
      "expect": { "ok": true, "matched": 1 }
    },
    {
      "method": "query",
      "args": [{ "json": { "Years": { "2027": [{ "Name": "春节", "StartDate": "2027-02-05", "CompDays": ["2027-01-31"] }, { "Name": "元旦", "CompDays": [] }] }, "Generated": "20261107T014237Z" }, "select": "..CompDays[*]", "paths": true }],
      "expect": { "ok": true, "matched": 1, "returned": 1, "truncated": false, "items": [{ "path": "$.Years.2027[0].CompDays[0]", "value": "2027-01-31" }] }
    },
    {
      "method": "query",
      "args": [{ "text": "{\"a\":{\"b\":2},\"c\":3}", "select": "a.b", "paths": false }],
      "expect": { "ok": true, "matched": 1, "returned": 1, "truncated": false, "items": [2] }
    },
    {
      "method": "grep",
      "args": [{ "json": { "Years": { "2027": [{ "Name": "春节", "StartDate": "2027-02-05", "CompDays": ["2027-01-31"] }, { "Name": "元旦", "CompDays": [] }] }, "Generated": "20261107T014237Z" }, "pattern": "^2027-" }],
      "expect": { "ok": true, "matched": 2, "returned": 2, "truncated": false, "items": [{ "path": "$.Years.2027[0].StartDate", "value": "2027-02-05" }, { "path": "$.Years.2027[0].CompDays[0]", "value": "2027-01-31" }] }
    },
    {
      "method": "grep",
      "args": [{ "json": { "Years": { "2027": [{ "Name": "春节", "StartDate": "2027-02-05", "CompDays": ["2027-01-31"] }, { "Name": "元旦", "CompDays": [] }] }, "Generated": "20261107T014237Z" }, "pattern": "元旦", "count": true }],
      "expect": { "ok": true, "matched": 1 }
    },
    {
      "method": "outline",
      "args": [{ "json": { "Years": { "2027": [{ "Name": "春节", "StartDate": "2027-02-05", "CompDays": ["2027-01-31"] }, { "Name": "元旦", "CompDays": [] }] }, "Generated": "20261107T014237Z" }, "path": "Years.2027[0]" }],
      "expect": { "ok": true, "matched": 1, "nodes": [{ "type": "object", "keys": ["Name", "StartDate", "CompDays"], "path": "$.Years.2027[0]" }] }
    }
  ]
}

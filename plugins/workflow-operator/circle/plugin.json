{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "workflow-operator.circle",
  "name": "弈友圈关系算子",
  "type": "plugin",
  "pointId": "workflow-operator",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/workflow-operator/circle/index.js",
  "origin": "manual",
  "intent": "对围棋对局数据执行确定性的关系图计算：清洗对局行、按棋手对聚合边、计算节点度数与对局数、连通分量和共同对手。只处理 Workflow 上游传入的数据，不负责网络采集、HTML/JSON 解析或分页；零网络、零时钟、零随机数、零阈值判定。",
  "readme": "plugins/workflow-operator/circle/README.md",
  "license": "MIT",
  "tags": [
    "workflow-operator",
    "weiqi",
    "graph",
    "relationship",
    "analysis"
  ],
  "category": "围棋",
  "exposes": [
    {
      "name": "pickOpponents",
      "description": "从 rootUid 的对局中按出现局数降序、uid 升序选取 opponentCount 个对手；maxHops=1 时返回空数组。仅计算围棋对手关系，不采集棋谱。",
      "inputSchema": {
        "type": "object",
        "required": [
          "games",
          "rootUid",
          "opponentCount",
          "maxHops"
        ],
        "properties": {
          "games": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "rootUid": {
            "type": "string"
          },
          "opponentCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "maxHops": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "normalize",
      "description": "把标准化对局行投影成可复算的关系事实。入参 {games:[对局行], rootUid:字符串}；返回 {stats, nodes, components, edges, commonOpponents}。只做围棋关系图计算，不负责取数、页面解析或字段提取。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "games",
          "rootUid"
        ],
        "properties": {
          "games": {
            "type": "array",
            "description": "通用采集/解析节点产出的标准化对局行数组；不绑定野狐或任何特定来源。",
            "items": {
              "type": "object"
            }
          },
          "rootUid": {
            "type": "string",
            "description": "主账号 uid；Workflow 上游的通用字段转换节点应先统一为字符串。"
          }
        }
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "summary",
      "description": "从 normalize 的完整关系图结果中提取 LLM 分析所需的 stats/nodes/components/commonOpponents，排除 edges 明细。",
      "inputSchema": {
        "type": "object",
        "required": [
          "analysis"
        ],
        "properties": {
          "analysis": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "stats",
          "nodes",
          "components",
          "commonOpponents"
        ],
        "properties": {
          "stats": {
            "type": "object"
          },
          "nodes": {
            "type": "array"
          },
          "components": {
            "type": "array"
          },
          "commonOpponents": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "kind": "pure",
      "idempotent": true
    }
  ],
  "smoke": [
    {
      "method": "pickOpponents",
      "args": [

{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "workflow-operator.circle",
  "name": "弈友圈关系算子",
  "type": "plugin",
  "pointId": "workflow-operator",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/workflow-operator/circle/index.js",
  "origin": "manual",
  "intent": "把通用 Workflow 采集并清洗后的围棋对局行投影成可复算的关系计数与图结构。只做纯计算，不访问网络、时钟或宿主资源。",
  "readme": "plugins/workflow-operator/circle/README.md",
  "license": "MIT",
  "tags": [
    "workflow-operator",
    "circle",
    "foxwq",
    "graph",
    "normalize"
  ],
  "category": "围棋",
  "exposes": [
    {
      "name": "normalize",
      "description": "把 Workflow 的 web_fetch 与 JSON 算子收集的紧凑对局行投影成 {stats,nodes,components,edges,commonOpponents}；fetchFailures 记录对手采集失败数。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "games",
          "rootUid"
        ],
        "properties": {
          "games": {
            "type": "array",
            "description": "由 Workflow 的 web_fetch + JSON 算子采集、整理的紧凑对局行，字段含 chessid / blackuid / blacknick / blackdan / whiteuid / whitenick / whitedan / starttime / winner 等。",
            "items": {
              "type": "object"
            }
          },
          "rootUid": {
            "type": "string",
            "description": "主账号 uid，必须是字符串。"
          },
          "fetchFailures": {
            "type": "integer",
            "minimum": 0,
            "description": "对手采集失败的账号数；省略时按 0 处理。"
          }
        }
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    }
  ],

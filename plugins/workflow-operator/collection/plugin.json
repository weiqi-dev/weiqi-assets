{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "workflow-operator.collection",
  "name": "集合处理算子",
  "type": "plugin",
  "pointId": "workflow-operator",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/workflow-operator/collection/index.js",
  "origin": "manual",
  "intent": "提供确定性的通用数组处理能力：展平、按路径去重、分组、投影、排序和切片。只处理传入 JSON，不访问宿主能力。",
  "readme": "plugins/workflow-operator/collection/README.md",
  "license": "MIT",
  "tags": [
    "workflow-operator",
    "collection",
    "array",
    "transform"
  ],
  "category": "算子",
  "exposes": [
    {
      "name": "singleton",
      "description": "把任意 JSON 值包装成单元素数组。",
      "inputSchema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {}
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "join",
      "description": "按顺序连接 left 与 right 两个数组。",
      "inputSchema": {
        "type": "object",
        "required": [
          "left",
          "right"
        ],
        "properties": {
          "left": {
            "type": "array"
          },
          "right": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "statusSummary",
      "description": "统计 boolean 状态数组中的失败项，返回 total / failed / complete。",
      "inputSchema": {
        "type": "object",
        "required": [
          "statuses"
        ],
        "properties": {
          "statuses": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "total",
          "failed",
          "complete"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "concat",
      "description": "按输入顺序连接多个数组，不递归展平。",
      "inputSchema": {
        "type": "object",
        "required": [
          "arrays"
        ],
        "properties": {
          "arrays": {
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "flatten",
      "description": "递归展平嵌套数组。",
      "inputSchema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "uniqueBy",
      "description": "按对象路径字段保留首次出现的元素。",
      "inputSchema": {
        "type": "object",
        "required": [
          "items",
          "key"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "key": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "groupBy",
      "description": "按对象路径字段分组，返回 key 到数组的映射。",
      "inputSchema": {
        "type": "object",
        "required": [
          "items",
          "key"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "key": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "pluck",
      "description": "按对象路径提取每个元素的字段值。",
      "inputSchema": {
        "type": "object",
        "required": [
          "items",
          "path"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "sortBy",
      "description": "按对象路径排序，order=desc 时降序，否则升序。",
      "inputSchema": {
        "type": "object",
        "required": [
          "items",
          "key"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "key": {
            "type": "string"
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "take",
      "description": "取数组前 count 项，fromEnd=true 时取末尾 count 项。",
      "inputSchema": {
        "type": "object",
        "required": [
          "items",
          "count"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "fromEnd": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array"
      },
      "kind": "pure",
      "idempotent": true
    }
  ],
  "smoke": [
    {
      "method": "statusSummary",
      "args": [
        {
          "statuses": [
            true,
            false,
            true
          ]
        }
      ],
      "expect": {
        "total": 3,
        "failed": 1,
        "complete": false
      }
    },
    {
      "method": "join",
      "args": [
        {
          "left": [
            1,
            2
          ],
          "right": [
            3
          ]
        }
      ],
      "expect": [
        1,
        2,
        3
      ]
    },
    {
      "method": "singleton",
      "args": [
        {
          "value": {
            "url": "https://example.com"
          }
        }
      ],
      "expect": [
        {
          "url": "https://example.com"
        }
      ]
    },
    {
      "method": "concat",
      "args": [
        {
          "arrays": [
            [
              1,
              2
            ],
            [
              3
            ]
          ]
        }
      ],
      "expect": [
        1,
        2,
        3
      ]
    },
    {
      "method": "uniqueBy",
      "args": [
        {
          "items": [
            {
              "id": "a"
            },
            {
              "id": "a"
            },
            {
              "id": "b"
            }
          ],
          "key": "id"
        }
      ],
      "expect": [
        {
          "id": "a"
        },
        {
          "id": "b"
        }
      ]
    },
    {
      "method": "groupBy",
      "args": [
        {
          "items": [
            {
              "kind": "x",
              "v": 1
            },
            {
              "kind": "y",
              "v": 2
            },
            {
              "kind": "x",
              "v": 3
            }
          ],
          "key": "kind"
        }
      ],
      "expect": {
        "x": [
          {
            "kind": "x",
            "v": 1
          },
          {
            "kind": "x",
            "v": 3
          }
        ],
        "y": [
          {
            "kind": "y",
            "v": 2
          }
        ]
      }
    }
  ]
}

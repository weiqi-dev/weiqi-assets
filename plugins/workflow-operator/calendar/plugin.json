{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "workflow-operator.calendar",
  "name": "月历算子（公历+农历+节气+节日+法定假）",
  "type": "plugin",
  "pointId": "workflow-operator",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/workflow-operator/calendar/index.js",
  "origin": "manual",
  "intent": "为宿主工作流算子表提供一个纯计算算子 buildMonth：把公历月表所需的历法事实（朔闰、24 节气、传统节日）与 workflow 注入的法定节假日 JSON 一次合并并排版成 {weeks[], legend[]}，供宿主 display_json_list 旁路渲染。整张月历由 DAG 自产出，模型只填 year/month、只收完成与句柄，不接触业务数据。不联网、不读取运行时时钟；历法来自内置 HKO 1901-2100 事实表，法定假由上游节点注入，取不到即抛错，绝不编造。",
  "readme": "plugins/workflow-operator/calendar/README.md",
  "license": "MIT",
  "tags": [
    "workflow-operator",
    "calendar",
    "lunar",
    "solar-term",
    "festival",
    "holiday",
    "month-calendar"
  ],
  "category": "生活",
  "exposes": [
    {
      "name": "buildMonth",
      "description": "生成一张公历月表的最终可渲染数据。传 {year:整数, month:1-12, holidays:节假日JSON}；返回 {weeks[], legend[]}。weeks[] 每项 {mon..sun} 七个纯文本单元格，放假日用带圈数字 ①..㉛，其余用普通数字，单元格内容按传统节日>节气>农历日名只取一个；legend[] 每项 {text} 为表格外说明（农历月段、本月节气与节日、法定放假日、调休上班日、数据来源）。holidays 的 Years 按年份映射假期数组，StartDate..EndDate 连休区间内每天为法定放假日，CompDays 为调休上班日；补班同日优先。years/month 越界或 holidays 结构不合法即抛错。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "month",
          "holidays"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "description": "公历年；历法事实表覆盖 1900-2100 农历年，超出范围由换算逻辑抛错"
          },
          "month": {
            "type": "integer",
            "description": "公历月 1-12"
          },
          "holidays": {
            "type": "object",
            "description": "节假日 JSON，含 Years 年份映射；由 workflow 的 web_fetch(storeOnly) 经绑定注入，插件自身零网络"
          }
        }
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    }
  ],

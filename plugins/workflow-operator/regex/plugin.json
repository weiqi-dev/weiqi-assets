{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "workflow-operator.regex",
  "name": "正则算子",
  "type": "plugin",
  "pointId": "workflow-operator",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/workflow-operator/regex/index.js",
  "origin": "manual",
  "intent": "为 Workflow 提供通用正则匹配、提取与替换，使用 ECMAScript RegExp 语义，纯计算，不访问宿主资源。",
  "readme": "plugins/workflow-operator/regex/README.md",
  "license": "MIT",
  "tags": [
    "workflow-operator",
    "regex",
    "text"
  ],
  "category": "算子",
  "exposes": [
    {
      "name": "match",
      "description": "执行一次正则匹配，返回命中值、位置和捕获组。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "extract",
      "description": "提取全部正则命中，可选捕获组、去重、位置与条数限制。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "replace",
      "description": "按正则替换文本，默认全局替换。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    }
  ],
  "smoke": [
    {
      "method": "match",
      "args": [
        {
          "text": "abc123",
          "pattern": "\\d+"
        }
      ],
      "expect": {
        "matched": true,
        "value": "123",
        "index": 3,
        "groups": []
      }
    },
    {
      "method": "extract",
      "args": [
        {
          "text": "a1 b2",
          "pattern": "\\d+"
        }
      ],
      "expect": [
        "1",
        "2"
      ]
    },
    {
      "method": "replace",
      "args": [
        {
          "text": "a1 b2",
          "pattern": "\\d+",
          "replacement": "#"
        }
      ],
      "expect": "a# b#"
    }
  ]
}

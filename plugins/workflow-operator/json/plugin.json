{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "workflow-operator.json",
  "name": "JSON 与集合算子",
  "type": "plugin",
  "pointId": "workflow-operator",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/workflow-operator/json/index.js",
  "origin": "manual",
  "intent": "为 Workflow 提供通用 JSON 解析、路径读取与设置、筛选投影、数组合并去重、分组计数、排序截取、空值判断、断言、展平与标量字符串化。所有方法纯计算，不访问宿主资源。",
  "readme": "plugins/workflow-operator/json/README.md",
  "license": "MIT",
  "tags": [
    "workflow-operator",
    "json",
    "array",
    "collection"
  ],
  "category": "算子",
  "exposes": [
    {
      "name": "parse",
      "description": "解析 JSON 字符串并返回 JSON 值。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "stringify",
      "description": "把 JSON 值序列化为字符串。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "get",
      "description": "按安全路径读取字段。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "set",
      "description": "复制 JSON 值并按路径设置字段。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "select",
      "description": "按条件筛选数组并可选字段投影。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "pluck",
      "description": "从数组记录提取指定路径。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "concat",
      "description": "按顺序合并多个数组。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "unique",
      "description": "按完整值或指定路径稳定去重。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "append",
      "description": "复制数组并追加一个值。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "groupCount",
      "description": "按字段分组计数，按数量降序和键升序输出。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "sortBy",
      "description": "按字段排序。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "take",
      "description": "取数组前 count 项，count 为 0 到 100 的整数。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "isEmpty",
      "description": "判断 JSON 值是否为空。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "assert",
      "description": "验证值满足等值或不等值条件，不满足时抛出声明的错误。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "flatten",
      "description": "递归展开嵌套数组，保持原有元素顺序。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {},
      "kind": "pure",
      "idempotent": true
    },
    {
      "name": "toString",
      "description": "将字符串、数字或布尔值转换为字符串。",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "string"
      },
      "kind": "pure",
      "idempotent": true
    }
  ],
  "smoke": [
    {
      "method": "parse",
      "args": [
        {
          "text": "{\"a\":1}"
        }
      ],
      "expect": {
        "a": 1
      }
    },
    {
      "method": "stringify",
      "args": [
        {
          "value": {
            "a": 1
          }
        }
      ],
      "expect": "{\"a\":1}"
    },
    {
      "method": "get",
      "args": [
        {
          "value": {
            "a": {
              "b": 2
            }
          },
          "path": "a.b"
        }
      ],
      "expect": 2
    },
    {
      "method": "set",
      "args": [
        {
          "value": {
            "a": {
              "b": 2
            }
          },
          "path": "a.b",
          "nextValue": 3
        }
      ],
      "expect": {
        "a": {
          "b": 3
        }
      }
    },
    {
      "method": "select",
      "args": [
        {
          "items": [
            {
              "a": 1,
              "b": 2
            },
            {
              "a": 2,
              "b": 3
            }
          ],
          "where": {
            "a": 2
          },
          "pick": [
            "b"
          ]
        }
      ],
      "expect": [
        {
          "b": 3
        }
      ]
    },
    {
      "method": "pluck",
      "args": [
        {
          "items": [
            {
              "a": 1
            },
            {
              "a": 2
            }
          ],
          "path": "a"
        }
      ],
      "expect": [
        1,
        2
      ]
    },
    {
      "method": "concat",
      "args": [
        {
          "arrays": [
            [
              1
            ],
            [
              2,
              3
            ]
          ]
        }
      ],
      "expect": [
        1,
        2,
        3
      ]
    },
    {
      "method": "unique",
      "args": [
        {
          "items": [
            1,
            1,
            2
          ]
        }
      ],
      "expect": [
        1,
        2
      ]
    },
    {
      "method": "append",
      "args": [
        {
          "items": [
            1
          ],
          "value": 2
        }
      ],
      "expect": [
        1,
        2
      ]
    },
    {
      "method": "groupCount",
      "args": [
        {
          "items": [
            {
              "k": "a"
            },
            {
              "k": "b"
            },
            {
              "k": "a"
            }
          ],
          "path": "k"
        }
      ],
      "expect": [
        {
          "key": "a",
          "count": 2
        },
        {
          "key": "b",
          "count": 1
        }
      ]
    },
    {
      "method": "sortBy",
      "args": [
        {
          "items": [
            {
              "n": 2
            },
            {
              "n": 1
            }
          ],
          "path": "n"
        }
      ],
      "expect": [
        {
          "n": 1
        },
        {
          "n": 2
        }
      ]
    },
    {
      "method": "take",
      "args": [
        {
          "items": [
            1,
            2,
            3
          ],
          "count": 2
        }
      ],
      "expect": [
        1,
        2
      ]
    },
    {
      "method": "isEmpty",
      "args": [
        {
          "value": ""
        }
      ],
      "expect": true
    },
    {
      "method": "assert",
      "args": [
        {
          "value": 0,
          "equals": 0
        }
      ],
      "expect": true
    },
    {
      "method": "flatten",
      "args": [
        {
          "items": [
            [
              1,
              [
                2
              ]
            ],
            3
          ]
        }
      ],
      "expect": [
        1,
        2,
        3
      ]
    },
    {
      "method": "toString",
      "args": [
        {
          "value": 123
        }
      ],
      "expect": "123"
    },
    {
      "method": "select",
      "args": [
        {
          "items": [
            {
              "uid": "a"
            },
            {
              "uid": "b"
            },
            {
              "uid": ""
            }
          ],
          "where": {
            "uid": {
              "notIn": [
                "a",
                ""
              ]
            }
          }
        }
      ],
      "expect": [
        {
          "uid": "b"
        }
      ]
    },
    {
      "method": "select",
      "args": [
        {
          "items": [
            {
              "uid": 123
            },
            {
              "uid": "456"
            },
            {
              "uid": null
            }
          ],
          "where": {
            "uid": {
              "stringEq": "123"
            }
          }
        }
      ],
      "expect": [
        {
          "uid": 123
        }
      ]
    }
  ]
}

{
  "$schema": "../../../schema/plugin.schema.json",
  "id": "workflow-operator.lunar",
  "name": "公历转农历",
  "type": "plugin",
  "pointId": "workflow-operator",
  "specVersion": 1,
  "entry": "call",
  "code": "plugins/workflow-operator/lunar/index.js",
  "origin": "manual",
  "intent": "为宿主工作流算子表提供农历历法算子：把公历日期或日期范围换算成农历，并查 24 节气与传统节日，也能一次取回生成一张公历月表所需的紧凑历法视图；不联网、不依赖运行时时钟。节气用 HKO 1901-2100 逐年事实表，传统节日按明说的民俗约定判定；exposes[] 每个方法按名注册为宿主算子，供阶段二 workflow 节点按名调用。",
  "readme": "plugins/workflow-operator/lunar/README.md",
  "license": "MIT",
  "tags": [
    "workflow-operator",
    "calendar",
    "lunar",
    "date-range",
    "solar-term",
    "festival",
    "month-calendar"
  ],
  "exposes": [
    {
      "name": "toLunar",
      "description": "公历转农历。传 {date:YYYY-MM-DD} 或 {from,to} 或 {year,month,day}。返回 {from,to,count,days[]}；days 每项含 solar、lunar{年月日,isLeap}、lunarText、solarTerm（当日节气名或 null）、festival（当日传统节日名或 null）。",
      "params": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "单日 YYYY-MM-DD"
          },
          "from": {
            "type": "string",
            "description": "范围起始 YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "范围结束 YYYY-MM-DD"
          },
          "year": {
            "type": "number",
            "description": "数字形式单日的公历年"
          },
          "month": {
            "type": "number",
            "description": "数字形式单日的公历月"
          },
          "day": {
            "type": "number",
            "description": "数字形式单日的公历日"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "solarTerms",
      "description": "查 24 节气。传 {year:2027} 或 {from:2025,to:2027}（数字年份，含首尾）。返回 {years:[{year,terms:[{name,solar}]}],count}，每年恰好 24 个节气，日期来自 HKO 逐年事实表；1901-2100 之外的年份明确报错。",
      "params": {
        "type": "object",
        "properties": {
          "year": {
            "type": "number",
            "description": "单个公历年（1901-2100）"
          },
          "from": {
            "type": "number",
            "description": "连续年份范围起始"
          },
          "to": {
            "type": "number",
            "description": "连续年份范围结束"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "festivals",
      "description": "查传统节日。传 {date:YYYY-MM-DD} 或 {from,to}。返回 {from,to,count,days[]}，只含命中节日的日期；days 每项 {solar,lunar,festival}。规则：春节正月初一、元宵正月十五、端午五月初五、七夕七月初七、中元七月十五、中秋八月十五、重阳九月初九、腊八腊月初八、除夕=该腊月最后一天（廿九或三十）；闰月不算节日。",
      "params": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "单日 YYYY-MM-DD"
          },
          "from": {
            "type": "string",
            "description": "范围起始 YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "范围结束 YYYY-MM-DD"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "monthCalendar",
      "description": "公历月历紧凑视图。传 {year, month}（月 1-12）。一次返回生成一张月表所需的全部历法信息：{year,month,daysInMonth,firstWeekday,monthSpan[],days[]}；days 每项含 solar（公历日）、day（纯农历日名，无月份字眼，闰月加「闰」前缀）、term（当日节气名，无则省略）、festival（当日传统节日名，无则省略）；monthSpan[] 是本月跨到的农历月段（lunarYear/lunarMonth/isLeap/from/to）；firstWeekday 为月首星期（1=周一 .. 7=周日），daysInMonth 由 Date.UTC 推导。节气/节日直接来自本库事实表与明说的民俗约定，不需要调用方自行判定。",
      "params": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "description": "公历年"
          },
          "month": {
            "type": "integer",
            "description": "公历月 1-12"
          }
        },
        "required": [
          "year",
          "month"
        ],
        "additionalProperties": false
      }
    }
  ],

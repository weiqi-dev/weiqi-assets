{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weiqi-dev.github.io/weiqi-assets/schema/plugin.schema.json",
  "title": "weiqi-bot 插件工件元数据",
  "description": "字段对齐 weiqi-bot 的 PluginArtifact / PluginSpec。workflow-operator 的每个 exposes 方法必须声明 inputSchema、outputSchema、kind 与 idempotent；插件在无宿主能力的受限沙箱中执行。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "type",
    "pointId",
    "specVersion",
    "entry",
    "code",
    "origin",
    "intent"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "plugin"
    },
    "pointId": {
      "type": "string",
      "enum": [
        "ranking",
        "workflow-operator"
      ],
      "description": "宿主已注册的扩展点，来源 weiqi-bot/domain/plugin/types.ts 的 PLUGIN_SPECS；不允许自造。"
    },
    "specVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
      "description": "入口函数名；ranking 为 rank，workflow-operator 为 call。"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "llm",
        "manual"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "readme": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "可选：面板筛选分类。清单 registry.resources[] 为唯一事实源，此字段仅供清单未标时兼容补足；两者都写时宿主以清单为准。"
    },
    "exposes": {
      "type": "array",
      "description": "workflow-operator 算子插件方法白名单；每项完整声明输入/输出 JSON Schema、能力类型与幂等性。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "inputSchema",
          "outputSchema",
          "kind",
          "idempotent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "inputSchema": {
            "type": "object",
            "description": "算子入参 JSON Schema，根类型必须为 object"
          },
          "outputSchema": {
            "type": "object",
            "description": "算子出参 JSON Schema"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pure",
              "io",
              "effect"
            ]
          },
          "idempotent": {
            "type": "boolean"
          }
        }
      }
    },
    "smoke": {
      "type": "array",
      "description": "workflow-operator 算子插件专用：算子方法安装前沙箱自检样例。每项 {method?, args:[一个参数对象], expect:与 call 返回值逐字段相等}。",
      "items": {
        "type": "object",
        "required": [
          "args",
          "expect"
        ],
        "properties": {
          "method": {
            "type": "string",
            "description": "该样例调用的方法名；省略时用 exposes[0].name"
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          },
          "expect": {}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pointId": {
            "const": "workflow-operator"
          }
        }
      },
      "then": {
        "required": [
          "exposes",
          "smoke"
        ]
      }
    }
  ]
}

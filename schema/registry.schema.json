{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weiqi-dev.github.io/weiqi-assets/schema/registry.schema.json",
  "title": "weiqi-assets 顶层资源清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "name", "description", "baseUrl", "resources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "summary", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "type": { "type": "string", "enum": ["plugin", "tool"] },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "可选：面板筛选用的中文分类标签（纯展示）。取值见 docs/contributing.md 的分类表；宿主不认识的值会按 pointId / id 命名空间兜底推导，不影响安装。"
        },
        "pointId": { "type": "string" },
        "specVersion": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "pattern": "^(plugins|tools)/[A-Za-z0-9._/-]+\\.json$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "plugin" } } },
          "then": { "required": ["pointId", "specVersion"] }
        }
      ]
    }
  }
}
